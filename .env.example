# ====================================================
# SecureLens Environment Configuration Template
# Copy this file to '.env' for production deployments
# ====================================================

# ─── Database Configuration ─────────────────────────
DB_NAME=securelens_db
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_PORT=3306

# ─── Security Configuration ─────────────────────────
# Generate a strong 256-bit secret key for JWT in production
JWT_SECRET=4ec5e8b05fa878462bd10e0a722c6656bc02811343163b210e281fc0ac52030a

# ─── CORS & Domain Configuration ────────────────────
# Comma-separated allowed origins for API calls
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# Frontend public base URL
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# Backend API base URL (used during Frontend build)
REACT_APP_API_URL=http://localhost:8090

# ─── Third-Party Services ───────────────────────────
GOOGLE_CLIENT_ID=980019107126-trekepj3uiojgetr3hpeig4mt6a64lnj.apps.googleusercontent.com

# ─── SMTP Email Configuration ───────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=securelensz@gmail.com
MAIL_PASSWORD=your_smtp_app_password
